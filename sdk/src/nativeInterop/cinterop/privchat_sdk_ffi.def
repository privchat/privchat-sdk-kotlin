headers = privchat_sdk_ffi/privchat_sdk_ffi.h
headerFilter = privchat_sdk_ffi/privchat_sdk_ffi.h common/common.h

package = cinterop

staticLibraries.ios_arm64 = libprivchat_sdk_ffi.a
staticLibraries.ios_simulator_arm64 = libprivchat_sdk_ffi.a
staticLibraries.ios_x64 = libprivchat_sdk_ffi.a
staticLibraries.macos_arm64 = libprivchat_sdk_ffi.a
staticLibraries.macos_x64 = libprivchat_sdk_ffi.a
staticLibraries.ohos_arm64 = libprivchat_sdk_ffi.a

libraryPaths.ios_arm64 = ../../privchat-sdk/target/aarch64-apple-ios/release
libraryPaths.ios_simulator_arm64 = ../../privchat-sdk/target/aarch64-apple-ios-sim/release
libraryPaths.ios_x64 = ../../privchat-sdk/target/x86_64-apple-ios/release
libraryPaths.macos_arm64 = ../../privchat-sdk/target/aarch64-apple-darwin/release
libraryPaths.macos_x64 = ../../privchat-sdk/target/x86_64-apple-darwin/release
libraryPaths.ohos_arm64 = ../../privchat-sdk/target/aarch64-unknown-linux-ohos/release

# SQLCipher 的 Apple 随机数走 CommonCrypto（SecRandomCopyBytes/kSecRandomDefault），
# 静态库本身不带 autolink 元数据，必须由 cinterop 显式声明 Security.framework，
# 否则 macosArm64 测试可执行文件链接报 undefined symbols（iOS 由宿主 Xcode 工程链接）。
linkerOpts.ios_arm64 = -framework Security
linkerOpts.ios_simulator_arm64 = -framework Security
linkerOpts.ios_x64 = -framework Security
linkerOpts.macos_arm64 = -framework Security
linkerOpts.macos_x64 = -framework Security
